// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int       @id @default(autoincrement())
  googleUserId      String?   @unique @map("google_user_id")
  email             String?   @unique
  name              String?
  givenName         String?   @map("given_name")
  familyName        String?   @map("family_name")
  picture           String?
  score             String?   @default("3") // 对应积分情况
  credits           String?   @default("1") // 对应剩余点数
  accessToken       String?   @map("access_token") @db.Text
  createTime        DateTime? @default(now()) @map("create_time")
  updateTime        DateTime? @updatedAt @map("update_time")
  ip                String?
  type              String?   @default("1")
  last_daily_reward DateTime? @map("last_daily_reward")
  current_streak    String?   @default("0")
  plan              String?   @default("free")
  // 关联支付表
  payments              Pay[]
  connectDotsPuzzles    ConnectDotsPuzzle[]

  @@map("google_user")
}

model Pay {
  id            Int       @id @default(autoincrement())
  userId        Int?      @map("user_id")
  googleUserId  String?   @map("google_user_id")
  email         String?
  orderNo       String?   @map("order_no")
  checkoutUrl   String?   @map("checkout_url") @db.Text
  orderRequest  String?   @map("order_request") @db.Text
  orderResponse String?   @map("order_response") @db.Text
  retUrl        String?   @map("ret_url")
  cancelUrl     String?   @map("cancel_url")
  orderId       String?   @map("order_id")
  status        String?   @default("1") // 1.待支付 2.支付成功
  type          String? // 套餐类型
  businessType  String?   @map("business_type") // 3:stripe
  remark        String?
  amount        String?
  ip            String?
  timestamp     String?
  createTime    DateTime? @default(now()) @map("create_time")
  updateTime    DateTime? @updatedAt @map("update_time")

  user User? @relation(fields: [userId], references: [id])

  @@map("pay")
}

model ConnectDotsPuzzle {
  id                Int       @id @default(autoincrement())
  userId            Int       @map("user_id")
  slug              String    @unique
  title             String
  description       String?   @db.Text
  originalImageUrl  String    @map("original_image_url") @db.Text
  puzzleImageUrl    String    @map("puzzle_image_url") @db.Text
  difficulty        String    @default("medium")
  dotCount          Int       @map("dot_count")
  width             Int
  height            Int
  settings          String?   @db.Text
  isPublic          Boolean   @default(true) @map("is_public")
  createTime        DateTime  @default(now()) @map("create_time")
  updateTime        DateTime  @updatedAt @map("update_time")
  user              User      @relation(fields: [userId], references: [id])

  @@map("connect_dots_puzzle")
}

model Feedback {
  id             Int       @id @default(autoincrement())
  message        String    @db.Text
  contact        String?
  quickType      String?   @map("quick_type")
  helpfulVote    Boolean?  @map("helpful_vote")
  triggerSource  String?   @map("trigger_source")
  pageUrl        String?   @map("page_url") @db.Text
  pagePath       String?   @map("page_path")
  actionPath     String?   @map("action_path") @db.Text
  referrer       String?   @db.Text
  timezone       String?
  browserLang    String?   @map("browser_lang")
  deviceType     String?   @map("device_type")
  platform       String?
  userAgent      String?   @map("user_agent") @db.Text
  viewportWidth  Int?      @map("viewport_width")
  viewportHeight Int?      @map("viewport_height")
  screenWidth    Int?      @map("screen_width")
  screenHeight   Int?      @map("screen_height")
  ip             String?   @default("0.0.0.0")
  screenshot     String?   @db.LongText
  createTime     DateTime? @default(now()) @map("create_time")

  @@index([createTime], map: "feedback_create_time_idx")
  @@map("feedback")
}
