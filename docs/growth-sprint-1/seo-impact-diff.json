      "url": "/dot-to-dot-printable/",
      "status_before": 200,
      "status_after": 200,
      "protected_fields_equal": true,
      "protected_before_sha256": "754e7094743328f664ba980a5dac0a51b66d683cc115a88d31aac99a4d9d69fa",
