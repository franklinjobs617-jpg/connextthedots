      "href_sequence_equal": true,
      "main_text_equal": false,
      "jsonld_diff": [
        {
          "field": "/0/@graph/0/description",
          "before": "Browse dot-to-dot catalog entries. Open a card to check the preview and available downloads; adult reference artwork is not a verified numbered worksheet.",
          "after": "Browse free dot-to-dot printables by catalog range and theme. Open a card for the worksheet preview, PDF download and available solution."
        },
        {
          "field": "/0/@graph/1/mainEntity/1/acceptedAnswer/text",
          "before": "Static worksheet PDF downloads do not require an account. Open a card to view its downloads. PDFs are generated in your browser and include a website credit. AI image generation is separate and requires sign-in and available credits.",
          "after": "Static detail-page PDFs are free to download without an account. Open a card for its preview and download buttons. The browser-generated PDF includes a website credit."
        },
        {
          "field": "/0/@graph/1/mainEntity/3/acceptedAnswer/text",
          "before": "The detail-page PDF export uses A4 portrait. Check the preview before printing. US Letter output has not been verified; do not assume every worksheet fits without cropping.",
          "after": "The detail-page PDF export uses A4 portrait. Check the print preview and select Fit to page if needed. US Letter output has not been tested."
        },
        {
          "field": "/0/@graph/1/mainEntity/4/acceptedAnswer/text",
          "before": "Use the homepage image-upload flow to make a puzzle from your own image. A simple drawing with a clear outline is a useful starting point; review the result before printing. AI image generation requires sign-in and available credits.",
          "after": "Use the homepage image-upload flow to make a worksheet from your own image. A clear, simple outline is a useful starting point. AI image generation is separate and requires sign-in and available credits."
        },
        {
          "field": "/0/@graph/1/mainEntity/5/acceptedAnswer/text",
          "before": "Numbered dot-to-dot activities can offer a focused, screen-free break. The Mountain and Mandala entries here are reference artwork, not verified high-dot-count numbered worksheets. A playable adult worksheet and matching solution have not been confirmed for those entries.",
          "after": "Dot-to-dot activities can offer adults a focused, screen-free break. Choose a numbered worksheet with comfortable number spacing and a level of detail you enjoy; inspect its preview before printing."
        },
        {
          "field": "/0/@graph/2/step/0/text",
          "before": "Open a card to view worksheet details. Download PDF creates an A4 PDF from the Puzzle image; Download PNG exports the Solution image. These are different resources. Check availability before printing.",
          "after": "Open a card for its preview and download buttons. Download PDF creates an A4 file from the Puzzle image; Download PNG exports the available Solution image."
        }
      ]
    },
    {
      "url": "/connect-the-dots-for-adults/",
      "status_before": 200,
      "status_after": 200,
      "protected_fields_equal": true,
      "protected_before_sha256": "e674f235d7c4814bb55259179c51178f666d88bff14c297f9f74883f1254d964",
      "protected_after_sha256": "e674f235d7c4814bb55259179c51178f666d88bff14c297f9f74883f1254d964",
      "href_sequence_equal": true,
      "main_text_equal": false,
      "jsonld_diff": [
        {
          "field": "/0/@graph/2/mainEntity/0/acceptedAnswer/text",
          "before": "Adult dot-to-dot worksheets use numbered dots to build an outline. Difficulty depends on the actual sequence and readability; a title or difficulty label alone does not establish the number of dots or that a worksheet is ready to solve.",
          "after": "An adult dot-to-dot worksheet uses a numbered sequence to form an outline. Detail and number spacing influence the challenge, so start with the worksheet preview."
        },
        {
          "field": "/0/@graph/2/mainEntity/1/acceptedAnswer/text",
          "before": "Static detail-page PDF downloads do not require an account and include a website credit. The current Mountain and Mandala entries are reference artwork, not verified numbered worksheets. AI image generation requires sign-in and available credits.",
          "after": "Static detail-page PDFs are free, generated in your browser and include a website credit. No account is needed to download them."
        },
        {
          "field": "/0/@graph/2/mainEntity/2/acceptedAnswer/text",
          "before": "The dot counts of the current Mountain and Mandala entries have not been verified. Their catalog ranges must not be treated as confirmed counts of numbered dots. No playable 100+ dot adult worksheet is confirmed here.",
          "after": "Use a worksheet's catalog range as a selection guide, then inspect the numbered preview. A catalog label is not a point-by-point audit. See the featured-entry note for the current Mountain and Mandala status."
        },
        {
          "field": "/0/@graph/2/mainEntity/3/acceptedAnswer/text",
          "before": "Use the homepage upload flow to make a puzzle from your own image. Review the numbered result before printing; a clear outline is a useful starting point. A playable extreme puzzle from every photo is not guaranteed. AI image generation is separate and requires sign-in and available credits.",
          "after": "Use the homepage upload flow to make a worksheet from your own image. A clear outline is a useful starting point; inspect the result before printing. AI image generation is a separate feature requiring sign-in and available credits."
        },
        {
          "field": "/0/@graph/2/mainEntity/5/acceptedAnswer/text",
          "before": "The detail-page PDF export uses A4 portrait. Check the preview and print readability before printing. US Letter output has not been verified, and a downloadable PDF alone does not establish a playable numbered worksheet.",
          "after": "The detail-page PDF export uses A4 portrait. Check the print preview and number readability. US Letter output has not been tested."
        }
      ]
    },
